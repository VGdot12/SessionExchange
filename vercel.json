{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm ci --ignore-scripts",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [ { "source": "/api/:path*", "destination": "/api/index?__swap_route=:path*" } ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ] },
    { "source": "/api/:path*", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/:file(index.html|app.js|style.css|data-transfer.html|data-transfer.js|data-transfer.css)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
